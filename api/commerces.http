# ============================================
# COMMERCES - Comercios
# ============================================
# Gestión de comercios.
# Para documentación completa ver api/api.http
#
# Base URL: http://localhost:3000

@baseURL = http://localhost:3000
@token = your_jwt_token_here
@commerceId = 1

# ============================================
# POST /commerces
# ----------------------------------
# Descripción: Crea un nuevo comercio.
# Autenticación: REQUERIDA - Bearer token.
# Body (JSON):
#   {
#     "name": "Mi Tienda",         // OBLIGATORIO
#     "description": "Descripción",  // OPCIONAL
#     "nit": "12345678"         // OPCIONAL - NIT del comercio
#   }
# Headers:
#   Authorization: Bearer <token>

###
POST {{baseURL}}/commerces
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Nueva Tienda",
  "description": "Descripción de la tienda",
  "nit": "12345678"
}

# ============================================
# GET /commerces
# ----------------------------------
# Descripción: Lista todos los comercios.
# Autenticación: No requerida.

###
GET {{baseURL}}/commerces

# ============================================
# GET /commerces/:id
# ----------------------------------
# Descripción: Obtiene un comercio por ID.
# Autenticación: No requerida.
# Params: ID numérico del comercio

###
GET {{baseURL}}/commerces/{{commerceId}}

# ============================================
# GET /commerces/:id/products
# ----------------------------------
# Descripción: Obtiene los productos de un comercio.
# Autenticación: No requerida.
# Params: ID numérico del comercio

###
GET {{baseURL}}/commerces/{{commerceId}}/products

# ============================================
# PATCH /commerces/:id
# ----------------------------------
# Descripción: Actualiza un comercio.
# Autenticación: REQUERIDA - Solo el owner.

###
PATCH {{baseURL}}/commerces/{{commerceId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tienda Actualizada",
  "description": "Nueva descripción"
}

# ============================================
# DELETE /commerces/:id
# ----------------------------------
# Descripción: Elimina un comercio.
# Autenticación: REQUERIDA - Solo el owner.
# Nota: Eliminación física (no lógica).

###
DELETE {{baseURL}}/commerces/{{commerceId}}
Authorization: Bearer {{token}}
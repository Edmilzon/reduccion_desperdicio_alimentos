# ────────────────────────────────────────────
# FLUJO DE COMERCIOS / RESTAURANTES
# ────────────────────────────────────────────
#
# ENDPOINTS PÚBLICOS:
#   • GET /commerces               → lista con owner
#   • GET /commerces/list/all      → solo id + name (para selects)
#   • GET /commerces/nearby        → por coordenadas + distancia (filtro category opcional)
#   • GET /commerces/by-address    → geocodifica Nominatim + distancia
#   • GET /commerces/:id           → un comercio (con owner)
#   • GET /commerces/:id/products  → productos activos de ese comercio
#   • GET /restaurants/nearby      → igual que /commerces/nearby (duplicado)
#   • GET /restaurants/categories  → categorías con productos activos actualmente
#   • GET /restaurants/:id/detail  → detalle completo con ofertas activas
#
# ENDPOINTS PROTEGIDOS (JWT):
#   • POST   /commerces     → crear (cualquier usuario autenticado)
#   • PATCH  /commerces/:id → actualizar (solo owner)
#   • DELETE /commerces/:id → eliminar (solo owner, físico)
#
# ────────────────────────────────────────────

### Listar todos los comercios (con owner, sin locations ni products)
GET {{baseURL}}/commerces
# 200 → [ { id, name, description, latitude, longitude, rating, imageUrl, nit,
#           owner: { id, email, role }, createdAt, updatedAt } ]

### Listar solo IDs y nombres (para combos/selects)
GET {{baseURL}}/commerces/list/all
# 200 → [ { id, name } ]

### Buscar comercios cercanos por coordenadas (Haversine)
GET {{baseURL}}/commerces/nearby?lat=-16.5&lng=-68.15&radius=5
# 200 → [ { id, name, restaurantId, branchName, description, latitude, longitude,
#           rating, imageUrl, distance (km), availableOffers, hasActiveOffers,
#           pickupLimit (HH:mm) } ]
# Query opcional: &category=panaderia (slug o id numérico)
#   → filtra solo locations con productos activos de esa categoría
# Si radius ≤ 0 o no se envía, busca sin límite de distancia
# Errores:
#   400 → faltan lat/lng

### Buscar comercios cercanos por dirección (Nominatim → coordenadas → Haversine)
GET {{baseURL}}/commerces/by-address?address=La Paz, Bolivia&radius=5
# 200 → mismo formato que /nearby
# Interno: geocodifica address → coordenadas → findActiveByCoordinates
# Errores:
#   400 → falta address
#   404 → no se pudo geocodificar la dirección

### Obtener comercio por ID (con owner, sin locations ni products)
GET {{baseURL}}/commerces/{{commerceId}}
# 200 → { id, name, description, latitude, longitude, rating, imageUrl, nit,
#         owner: { id, email, role }, createdAt, updatedAt }
# Errores:
#   404 → commerce no encontrado

### Productos activos de un comercio
GET {{baseURL}}/commerces/{{commerceId}}/products
# 200 → { commerce: { id, name, description, ... },
#          products: [ { id, title, price, originalPrice, quantity, imageUrl,
#                        status, category: { id, name, slug }, ... } ] }
# Solo productos con status = "active"

### Crear comercio (requiere auth)
POST {{baseURL}}/commerces
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Nueva Tienda",
  "description": "Descripción de la tienda",
  "latitude": -16.5,
  "longitude": -68.15,
  "nit": "12345678"
}
# 201 → { id, name, description, latitude, longitude, rating, imageUrl, nit,
#         owner: { id, email }, createdAt, updatedAt }
# Errores:
#   401 → no autenticado
#   400 → validación de campos

### Actualizar comercio (solo owner)
PATCH {{baseURL}}/commerces/{{commerceId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tienda Actualizada",
  "description": "Nueva descripción"
}
# 200 → commerce object actualizado
# Errores:
#   401 → no autenticado
#   403 → no eres el owner del comercio
#   404 → commerce no encontrado

### Eliminar comercio (solo owner, eliminación física en cascada)
DELETE {{baseURL}}/commerces/{{commerceId}}
Authorization: Bearer {{token}}
# 200 → raw commerce entity eliminado (NO es un mensaje)
# Errores:
#   401 → no autenticado
#   403 → no eres el owner
#   404 → commerce no encontrado

### Buscar restaurantes cercanos (mismo que /commerces/nearby, duplicado)
GET {{baseURL}}/restaurants/nearby?lat=-16.5&lng=-68.15&radius=5
# 200 → mismo formato que /commerces/nearby
# Query opcional: &category=panaderia

### Categorías activas (con productos activos y stock en este momento)
GET {{baseURL}}/restaurants/categories
# 200 → [ { id, name, slug, createdAt, updatedAt } ]
# Solo categorías que tienen al menos un producto con status=active, quantity>0
# y pickupEnd >= ahora

### Detalle completo de restaurante con ofertas activas
GET {{baseURL}}/restaurants/{{commerceId}}/detail
# 200 → { id, name, description, address, phone, isActive,
#         offers: [ { id, name, description, originalPrice, price, quantity,
#                    pickupDeadline, expiryDate } ] }
# offers = productos activos con status=active

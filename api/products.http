# POST /products - Posibles errores
# 403: "No tienes permiso para añadir productos a este comercio"
# 404: "Categoría no encontrada"

# PATCH /products/:id - Posibles errores
# 403: "No tienes permiso para editar este producto"
# 404: "Producto no encontrado" | "Categoría no encontrada"

# DELETE /products/:id - Posibles errores
# 403: "No tienes permiso para eliminar este producto"
# 404: "Producto no encontrado"
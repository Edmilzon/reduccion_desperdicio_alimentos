# ============================================
# PRODUCTS - Productos (Eco Bocado)
# ============================================
# Módulo para gestionar productos excedentes de comercios.
# Los productos tienen categoría y pertencen a un comercio.
#
# Endpoints disponibles:
#   - GET /products              → Listar productos activos
#   - GET /products/all           → Listar todos con categoría
#   - GET /products/search?q=     → Buscar por título/descripción/comercio
#   - GET /products/categories    → Listar categorías
#   - GET /products/category/:id  → Productos por categoría
#   - GET /products/commerce/:id  → Productos por comercio
#   - GET /products/commerce/:id/stats → Estadísticas del comercio
#   - GET /products/:id           → Detalle de producto
#   - POST /products              → Crear producto (auth requerido)
#   - PATCH /products/:id         → Actualizar producto (auth requerido)
#   - DELETE /products/:id        → Eliminar producto (auth requerido)
#
# Base URL: http://localhost:3000 (desarrollo)
# Producción: https://reduccion-desperdicio-backend.vercel.app/

@baseURL = https://reduccion-desperdicio-backend.vercel.app/
@token = your_jwt_token_here
@commerceId = 1
@productId = 1
@categoryId = 1

# ============================================
# GET - CONSULTAS PÚBLICAS
# ============================================

### Listar todos los productos con su categoría
GET {{baseURL}}/products/all

### Buscar productos por título, descripción o nombre del comercio
GET {{baseURL}}/products/search?q=pan

### Listar productos activos (filtros opcionales: categoryId, commerceId)
GET {{baseURL}}/products
###
GET {{baseURL}}/products?categoryId={{categoryId}}
###
GET {{baseURL}}/products?commerceId={{commerceId}}
###
GET {{baseURL}}/products?categoryId={{categoryId}}&commerceId={{commerceId}}

### Obtener producto por ID
GET {{baseURL}}/products/{{productId}}

# ============================================
# GET - CATEGORÍAS
# ============================================

### Listar todas las categorías
GET {{baseURL}}/products/categories

### Obtener productos por categoría
GET {{baseURL}}/products/category/{{categoryId}}
###
GET {{baseURL}}/products/category/{{categoryId}}?commerceId={{commerceId}}

# ============================================
# GET - CONSULTAS POR COMERCIO
# ============================================

### Obtener productos por comercio (filtros: status, categoryId)
### status: "active" | "sold_out" | "expired" (default: active)
GET {{baseURL}}/products/commerce/{{commerceId}}
###
GET {{baseURL}}/products/commerce/{{commerceId}}?status=active
###
GET {{baseURL}}/products/commerce/{{commerceId}}?status=sold_out
###
GET {{baseURL}}/products/commerce/{{commerceId}}?status=active&categoryId={{categoryId}}

### Obtener estadísticas del comercio (requiere autenticación)
### Devuelve: ofertas activas, ofertas hoy, pedidos hoy, ventas hoy,
###            unidades vendidas, ofertas cerca de vencer (<2h)
GET {{baseURL}}/products/commerce/{{commerceId}}/stats
Authorization: Bearer {{token}}

# ============================================
# POST - CREAR PRODUCTO
# ============================================

### Crear producto (requiere autenticación)
### Solo el owner del comercio puede crear productos
POST {{baseURL}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Pan Integral",
  "description": "Pan integral fresco del día",
  "originalPrice": 5.00,
  "price": 3.50,
  "quantity": 20,
  "pickupStart": "2025-06-01T08:00:00Z",
  "pickupEnd": "2025-06-01T14:00:00Z",
  "commerceId": 1,
  "categoryId": 1,
  "imageUrl": "https://ejemplo.com/imagen.jpg"
}

# ============================================
# PATCH - ACTUALIZAR PRODUCTO
# ============================================

### Actualizar producto (requiere autenticación)
### Solo el owner del comercio puede actualizar
PATCH {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Pan Integral Actualizado",
  "price": 4.00,
  "quantity": 15,
  "categoryId": 2
}

### Ejemplo: actualizar solo precio
PATCH {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 2.50
}

# ============================================
# DELETE - ELIMINAR PRODUCTO
# ============================================

### Eliminar producto (soft delete)
### Marca el producto como "sold_out" en lugar de borrar
### Solo el owner del comercio puede eliminar
DELETE {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}


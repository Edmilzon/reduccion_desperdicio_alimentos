# ────────────────────────────────────────────
# FLUJO DE PRODUCTOS
# ────────────────────────────────────────────
#
# ENDPOINTS PÚBLICOS (GET):
#   • GET /products      → activos (filtros: categoryId, commerceId)
#   • GET /products/all  → todos (sin filtrar active) con categoría
#   • GET /products/search?q= → ILIKE en title, description, commerce.name
#   • GET /products/categories → todas las categorías
#   • GET /products/category/:categoryId → por categoría (query: commerceId)
#   • GET /products/commerce/:commerceId → por comercio (query: status, categoryId)
#   • GET /products/:id → un producto (con owner del commerce)
#
# ENDPOINTS PROTEGIDOS (JWT):
#   • POST   /products                     → crear (solo owner del commerceId)
#   • PATCH  /products/:id                 → actualizar (solo owner)
#   • DELETE /products/:id                 → soft delete (status = SOLD_OUT)
#   • GET /products/commerce/:commerceId/stats → panel (owner o admin)
#
# ────────────────────────────────────────────

### Listar productos activos (filtros: categoryId, commerceId)
GET {{baseURL}}/products
# 200 → [ { id, title, description, originalPrice, price, quantity, imageUrl,
#           pickupStart, pickupEnd, status, createdAt, updatedAt,
#           commerce: { id, name, description, latitude, longitude, rating,
#                      imageUrl, nit, createdAt, updatedAt,
#                      owner: { id, email, role } },
#           category: { id, name, slug, createdAt, updatedAt } } ]
# Nota: NO incluye location (relación no cargada)
# Query opcional: ?categoryId=1&commerceId=1

### Listar todos los productos con categoría (incluye no activos)
GET {{baseURL}}/products/all
# 200 → [ { id, title, description, originalPrice, price, quantity, imageUrl,
#           pickupStart, pickupEnd, status, createdAt, updatedAt,
#           category: { id, name, slug, createdAt, updatedAt } } ]
# Nota: Solo carga relación category (sin commerce ni location)

### Buscar productos por título, descripción o nombre del comercio
GET {{baseURL}}/products/search?q=pan
# 200 → [ { id, title, description, originalPrice, price, quantity, imageUrl,
#           pickupStart, pickupEnd, status, createdAt, updatedAt,
#           commerce: { id, name, ... },
#           category: { id, name, slug, ... } } ]
# Búsqueda case-insensitive con ILIKE, solo status = active

### Listar todas las categorías
GET {{baseURL}}/products/categories
# 200 → [ { id, name, slug, createdAt, updatedAt } ]

### Productos por categoría (query opcional: commerceId)
GET {{baseURL}}/products/category/{{categoryId}}
# 200 → [ { id, title, description, originalPrice, price, quantity, imageUrl,
#           pickupStart, pickupEnd, status, createdAt, updatedAt,
#           commerce: { id, name, ... },
#           category: { id, name, slug, ... } } ]
# Query opcional: ?commerceId=1

### Productos por comercio (query opcional: status, categoryId)
GET {{baseURL}}/products/commerce/{{commerceId}}
# 200 → [ { id, title, description, originalPrice, price, quantity, imageUrl,
#           pickupStart, pickupEnd, status, isNearExpiry (bool),
#           createdAt, updatedAt,
#           commerce: { id, name, ... },
#           category: { id, name, slug, ... } } ]
# Query opcional: ?status=active&categoryId=1
# isNearExpiry = true si faltan < 2h para pickup_end
# Si status no se envía o es inválido, filtra por active por defecto

### Estadísticas del comercio (requiere JWT, owner o admin)
GET {{baseURL}}/products/commerce/{{commerceId}}/stats
Authorization: Bearer {{token}}
# 200 → { activeOffers (count), todayOffers (count),
#         todayOrders (count), todaySales (number),
#         totalUnitsSold (number),
#         nearExpiryOffers: [ { id, title, quantity, pickupEnd, price } ],
#         nearExpiryCount }
# nearExpiry = productos activos con pickupEnd < 2h desde ahora
# Errores:
#   401 → no autenticado
#   403 → no eres owner ni admin

### Obtener producto por ID
GET {{baseURL}}/products/{{productId}}
# 200 → { id, title, description, originalPrice, price, quantity, imageUrl,
#         pickupStart, pickupEnd, status, createdAt, updatedAt,
#         commerce: { id, name, description, latitude, longitude, rating,
#                    imageUrl, nit, createdAt, updatedAt,
#                    owner: { id, email, role } },
#         category: { id, name, slug, createdAt, updatedAt } }
# Nota: NO incluye location (relación no cargada)
# Errores:
#   404 → producto no encontrado

### Crear producto (requiere JWT, solo owner del comercio)
POST {{baseURL}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Pan Integral",
  "description": "Pan integral fresco del día",
  "originalPrice": 5.00,
  "price": 3.50,
  "quantity": 20,
  "pickupStart": "2026-06-01T08:00:00Z",
  "pickupEnd": "2026-06-01T14:00:00Z",
  "commerceId": 1,
  "categoryId": 1,
  "imageUrl": "https://ejemplo.com/imagen.jpg"
}
# 201 → { id, title, description, originalPrice, price, quantity, imageUrl,
#         pickupStart, pickupEnd, status: "active", createdAt, updatedAt,
#         commerce: { id, name, ... },
#         category: { id, name, ... } | null }
# Errores:
#   401 → no autenticado
#   403 → no eres owner de ese commerceId
#   404 → commerceId no encontrado
#   400 → validación (pickupEnd > pickupStart, precios >= 0, etc.)

### Actualizar producto (requiere JWT, solo owner del comercio)
PATCH {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Pan Integral Actualizado",
  "price": 4.00,
  "quantity": 15
}
# 200 → full product entity actualizado
# Errores:
#   401 → no autenticado
#   403 → no eres owner del comercio
#   404 → producto no encontrado

### Eliminar producto (soft delete → status SOLD_OUT, solo owner)
DELETE {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
# 200 → full product entity con status: "sold_out" (NO es un mensaje)
# No elimina físicamente, cambia status a "sold_out"
# Errores:
#   401 → no autenticado
#   403 → no eres owner
#   404 → producto no encontrado

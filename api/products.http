# ────────────────────────────────────────────
# FLUJO DE PRODUCTOS
# ────────────────────────────────────────────
#
# ENDPOINTS PÚBLICOS (GET):
#   • GET /products      → activos (filtros: categoryId, commerceId)
#   • GET /products/all  → todos con categoría (sin filtrar active)
#   • GET /products/search?q= → ILIKE en title, description, commerce.name
#   • GET /products/categories → lista de categorías
#   • GET /products/category/:categoryId → por categoría (query: commerceId)
#   • GET /products/commerce/:commerceId → por comercio (query: status, categoryId)
#   • GET /products/:id → un producto
#
# ENDPOINTS PROTEGIDOS (requieren JWT):
#   • POST   /products     → crear (solo owner del commerceId)
#   • PATCH  /products/:id → actualizar (solo owner del comercio)
#   • DELETE /products/:id → soft delete → status = SOLD_OUT (solo owner)
#
# ENDPOINT PROTEGIDO (owner o admin):
#   • GET /products/commerce/:commerceId/stats → estadísticas del comercio
#
# ────────────────────────────────────────────

### Listar productos activos (filtros opcionales: categoryId, commerceId)
GET {{baseURL}}/products
# 200 → [ { id, title, description, originalPrice, price, quantity, imageUrl,
#           pickupStart, pickupEnd, status, commerce: { id, name },
#           category: { id, name }, location: { id, name } | null } ]

### Listar todos los productos con categoría (incluye no activos)
GET {{baseURL}}/products/all
# 200 → [ { id, title, status, price, quantity, category: { id, name }, ... } ]

### Buscar productos por título, descripción o nombre del comercio
GET {{baseURL}}/products/search?q=pan
# 200 → [ { id, title, description, price, commerce: { id, name }, ... } ]
# Búsqueda case-insensitive con ILIKE

### Listar todas las categorías
GET {{baseURL}}/products/categories
# 200 → [ { id, name, slug } ]

### Productos por categoría (query opcional: commerceId para filtrar)
GET {{baseURL}}/products/category/{{categoryId}}
# 200 → [ { id, title, price, quantity, commerce: { id, name }, ... } ]
# Query opcional: ?commerceId=1

### Productos por comercio (query opcional: status, categoryId)
GET {{baseURL}}/products/commerce/{{commerceId}}
# 200 → [ { id, title, description, originalPrice, price, quantity, imageUrl,
#           pickupStart, pickupEnd, status, isNearExpiry (bool),
#           category: { id, name }, location: { id, name } | null } ]
# Query opcional: ?status=active&categoryId=1
# isNearExpiry = true si faltan < 2h para pickup_end

### Estadísticas del comercio (requiere auth, owner o admin)
GET {{baseURL}}/products/commerce/{{commerceId}}/stats
Authorization: Bearer {{token}}
# 200 → { activeOffers, todayOffers, todayOrders, todaySales (suma total),
#         totalUnitsSold, nearExpiryOffers: [ { id, title, quantity,
#           pickupEnd, timeLeft (minutos) } ], nearExpiryCount }
# Errores:
#   401 → no autenticado
#   403 → no eres owner ni admin

### Obtener producto por ID
GET {{baseURL}}/products/{{productId}}
# 200 → { id, title, description, originalPrice, price, quantity, imageUrl,
#         pickupStart, pickupEnd, status, commerce: { id, name, rating },
#         category: { id, name, slug }, location: { id, name } | null,
#         createdAt, updatedAt }
# Errores:
#   404 → producto no encontrado

### Crear producto (requiere auth, solo owner del comercio)
POST {{baseURL}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Pan Integral",
  "description": "Pan integral fresco del día",
  "originalPrice": 5.00,
  "price": 3.50,
  "quantity": 20,
  "pickupStart": "2026-06-01T08:00:00Z",
  "pickupEnd": "2026-06-01T14:00:00Z",
  "commerceId": 1,
  "categoryId": 1,
  "imageUrl": "https://ejemplo.com/imagen.jpg"
}
# 201 → { id, title, ..., status: "active", createdAt, updatedAt }
# Errores:
#   401 → no autenticado
#   403 → no eres owner de ese commerceId
#   404 → commerceId no encontrado
#   400 → validación (pickupEnd > pickupStart, precios >= 0, etc.)

### Actualizar producto (requiere auth, solo owner del comercio)
PATCH {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Pan Integral Actualizado",
  "price": 4.00,
  "quantity": 15
}
# 200 → product object actualizado
# Errores:
#   401 → no autenticado
#   403 → no eres owner del comercio
#   404 → producto no encontrado

### Eliminar producto (soft delete → status SOLD_OUT, solo owner)
DELETE {{baseURL}}/products/{{productId}}
Authorization: Bearer {{token}}
# 200 → { message: "Producto marcado como agotado" }
# No elimina físicamente, cambia status a "sold_out"
# Errores:
#   401 → no autenticado
#   403 → no eres owner
#   404 → producto no encontrado

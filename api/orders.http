# ============================================
# ORDERS - Pedidos
# ============================================
# Gestión de pedidos de productos.
#
# Base URL: http://localhost:3000

@baseURL = https://reduccion-desperdicio-backend.vercel.app/
@token = your_jwt_token_here
@productId = 1
@orderId = 1

# ============================================
# POST /orders
# ----------------------------------
# Descripción: Crea un nuevo pedido para un producto.
# Autenticación: REQUERIDA - Bearer token.
#              El usuario debe estar logueado.
# Body (JSON):
#   {
#     "productId": 1,        // OBLIGATORIO - ID del producto (number)
#     "quantity": 2,         // OBLIGATORIO - Cantidad (mínimo 1)
#     "paymentMethod": "online" // OPCIONAL - "cash" | "online" (default: cash)
#   }
# Headers:
#   Authorization: Bearer <token>
# Respuesta exitosa (201):
#   {
#     "id": 1,
#     "buyer": { "id": 1 },
#     "product": { "id": 1 },
#     "quantity": 2,
#     "totalPrice": 7.00,
#     "status": "confirmed",
#     "paymentMethod": "cash",
#     "paymentStatus": "pending",
#     "deliveryStatus": "pending",
#     "createdAt": "..."
#   }
# Errores comunes:
#   - 401 Unauthorized: Sin token
#   - 400 Bad Request: Datos inválidos
#   - 404 Not Found: Producto no existe
#   - 400: No hay suficiente stock

###
# Crear orden (requiere autenticación)
POST {{baseURL}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": 1,
  "quantity": 2,
  "paymentMethod": "cash"
}

# ============================================
# GET /orders/my-orders
# ----------------------------------
# Descripción: Lista todos los pedidos del usuario actual.
# Autenticación: REQUERIDA - Bearer token.
# Headers:
#   Authorization: Bearer <token>
# Respuesta exitosa (200):
#   [
#     {
#       "id": 1,
#       "product": { "id": 1, "title": "...", "commerce": { "id": 1, "name": "..." } },
#       "quantity": 2,
#       "totalPrice": 7.00,
#       "status": "confirmed",
#       "createdAt": "..."
#     }
#   ]
# Muestra solo los pedidos del usuario logueado.

###
# Obtener mis órdenes (requiere autenticación)
GET {{baseURL}}/orders/my-orders
Authorization: Bearer {{token}}

# ============================================
# PATCH /orders/:id/cancel
# ----------------------------------
# Descripción: Cancela un pedido existente.
# Autenticación: REQUERIDA - Bearer token.
#              Solo el creador del pedido puede cancelarlo.
# Params:
#   :id - ID numérico del pedido (reemplaza {{orderId}})
# Respuesta exitosa (200):
#   { "message": "Orden cancelada", "status": "cancelled" }
# Estados posibles: confirmed, cancelled
# Errores comunes:
#   - 401 Unauthorized: Sin token
#   - 404 Not Found: La orden no existe o no te pertenece
#   - 400: La orden ya fue cancelada

###
# Cancelar orden (requiere autenticación)
PATCH {{baseURL}}/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}
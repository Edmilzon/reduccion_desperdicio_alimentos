# ============================================
# FLUJO COMPLETO - Registro de Comerciante
# ============================================
# Este documento describe el flujo para registrar un comerciante,
# crear su comercio, y gestionar productos.

@baseURL = http://localhost:3000

# ============================================
# Paso 1: Registrar comerciante con comercio
# ============================================
# POST /auth/register-commerce
# Registra un usuario con rol MERCHANT y crea su comercio asociado.
# El usuario queda logueado automáticamente.

POST {{baseURL}}/auth/register-commerce
Content-Type: application/json

{
  "ownerName": "Juan Perez",
  "email": "tienda@example.com",
  "password": "password123",
  "commerceName": "Panadería Don Juan",
  "description": "Panadería fresca",
  "nit": "123456789"
}

# Respuesta:
# {
#   "user": { "id": 1, "email": "tienda@example.com", "role": "MERCHANT", ... },
#   "commerce": { "id": 1, "name": "Panadería Don Juan" },
#   "access_token": "eyJhbGciOiJIUzI1NiIs..."
# }

# GUARDA EL access_token PARA LOS SIGUIENTES PASOS

# ============================================
# Paso 2: Ver perfil del usuario
# ============================================
# GET /auth/me
# Verifica que el usuario está logueado y obtiene su información.

@token = eyJhbGciOiJIUzI1NiIs...

GET {{baseURL}}/auth/me
Authorization: Bearer {{token}}

# ============================================
# Paso 3: Ver tu comercio
# ============================================
# GET /commerces/:id
# Ver los datos del comercio creado.
# Reemplaza :id con el commerceIddevuelto o el id del usuario.

@commerceId = 1

GET {{baseURL}}/commerces/{{commerceId}}
Authorization: Bearer {{token}}

# ============================================
# Paso 4: Ver productos de tu comercio
# ============================================
# GET /commerces/:id/products
# Lista todos los productos activos del comercio.

GET {{baseURL}}/commerces/{{commerceId}}/products
Authorization: Bearer {{token}}

# ============================================
# Paso 5: Crear un nuevo producto
# ============================================
# POST /products
# Crea un producto en tu comercio.
# Solo el owner del comercio puede crear productos.

POST {{baseURL}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "PanIntegral",
  "description": "Pan integral fresco",
  "originalPrice": 5.00,
  "price": 3.50,
  "quantity": 20,
  "pickupStart": "2026-05-06T08:00:00Z",
  "pickupEnd": "2026-05-06T14:00:00Z",
  "commerceId": 1,
  "categoryId": 1
}

# ============================================
# Resumen de endpoints útiles
# ============================================
# Autenticación:
#   POST /auth/register-commerce - Crear comerciante + comercio → devuelve { user, commerce, access_token }
#   POST /auth/login               - Iniciar sesión
#   GET  /auth/me                 - Ver perfil actual
#
# Comercios:
#   GET /commerces              - Listar todos
#   GET /commerces/:id          - Ver comercio específico
#   GET /commerces/:id/products - Ver productos del comercio
#
# Productos:
#   GET /products                         - Productos activos (filtros)
#   GET /products/commerce/:commerceId  - Productos de un comercio
#   GET /products/commerce/:commerceId/stats - Estadísticas del día
#   POST /products                       - Crear producto (auth requerido)
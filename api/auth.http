# ============================================
# AUTH - Autenticación
# ============================================
# Este módulo maneja el registro, login, logout y perfil de usuarios.
# Base URL: http://localhost:3000

@baseURL = https://reduccion-desperdicio-backend.vercel.app/
@token = your_jwt_token_here

# ============================================
# POST /auth/register
# ----------------------------------
# Descripción: Registra un nuevo usuario en el sistema.
# Autenticación: No requerida.
# Body (JSON):
#   {
#     "name": "Juan Perez",        // OBLIGATORIO - Nombre completo
#     "email": "juan@example.com", // OBLIGATORIO - Email válido
#     "password": "password123",   // OBLIGATORIO - Mínimo 6 caracteres
#     "role": "CLIENT"             // OPCIONAL - CLIENT, MERCHANT, ADMIN (default: CLIENT)
#   }
# Respuesta exitosa (201):
#   {
#     "user": {
#       "id": "uuid-del-usuario",
#       "email": "juan@example.com",
#       "name": "Juan Perez",
#       "role": "CLIENT"
#     },
#     "access_token": "eyJhbGciOiJIUzI1NiIs..."
#   }
# Errores comunes:
#   - 409 Conflict: "El correo ya está registrado"

###
# Registrar nuevo usuario
POST {{baseURL}}/auth/register
Content-Type: application/json

{
  "name": "Juan Perez",
  "email": "juan@example.com",
  "password": "password123"
}

# ============================================
# POST /auth/login
# ----------------------------------
# Descripción: Inicia sesión y devuelve un token JWT.
# Autenticación: No requerida.
# Body (JSON):
#   {
#     "email": "juan@example.com", // OBLIGATORIO
#     "password": "password123"     // OBLIGATORIO
#   }
# Respuesta exitosa (200):
#   {
#     "user": {
#       "id": "uuid-del-usuario",
#       "email": "juan@example.com",
#       "name": "Juan Perez",
#       "role": "CLIENT"
#     },
#     "access_token": "eyJhbGciOiJIUzI1NiIs..."
#   }
# El token tiene una expiración configurable (default 24h).
# Usa este token en el header Authorization: Bearer <token>
# Errores comunes:
#   - 401 Unauthorized: Credenciales inválidas

###
# Iniciar sesión
POST {{baseURL}}/auth/login
Content-Type: application/json

{
  "email": "juan@example.com",
  "password": "password123"
}

# ============================================
# POST /auth/register-commerce
# ----------------------------------
# Descripción: Registra un nuevo usuario Y crea un comercio asociado.
#              Es el flujo completo para crear un comerciante (MERCHANT).
# Autenticación: No requerida.
# Body (JSON):
#   {
#     "ownerName": "Juan Perez",     // OBLIGATORIO - Nombre del dueño
#     "email": "juan@example.com",  // OBLIGATORIO
#     "password": "password123",     // OBLIGATORIO - mínimo 6 caracteres
#     "commerceName": "Mi Tienda",  // OBLIGATORIO - Nombre del comercio
#     "description": "Tienda",     // OPCIONAL
#     "latitude": 4.7110,           // OPCIONAL
#     "longitude": -74.0721,        // OPCIONAL
#     "nit": "123456789"           // OPCIONAL
#   }
# Respuesta exitosa (201):
#   {
#     "user": {
#       "id": "uuid-del-usuario",
#       "email": "juan@example.com",
#       "name": "Juan Perez",
#       "role": "MERCHANT"
#     },
#     "access_token": "eyJhbGciOiJIUzI1NiIs..."
#   }
# El usuario se crea con rol MERCHANT automáticamente.

###
# Registrar usuario con comercio (dueño)
POST {{baseURL}}/auth/register-commerce
Content-Type: application/json

{
  "ownerName": "Juan Perez",
  "email": "juan@example.com",
  "password": "password123",
  "commerceName": "Mi Tienda",
  "description": "Tienda de alimentos",
  "latitude": 4.7110,
  "longitude": -74.0721,
  "nit": "123456789"
}

# ============================================
# POST /auth/logout
# ----------------------------------
# Descripción: Cierra la sesión del usuario actual.
# Autenticación: REQUERIDA - Bearer token.
# Body: No requiere body.
# Headers:
#   Authorization: Bearer <token>
# Respuesta exitosa (200):
#   { "message": "Sesión cerrada exitosamente. Asegúrese de eliminar el token en el cliente." }
# Nota: En JWT, el logout se maneja del lado del cliente eliminando el token.

###
# Cerrar sesión
POST {{baseURL}}/auth/logout
Authorization: Bearer {{token}}

# ============================================
# GET /auth/me
# ----------------------------------
# Descripción: Obtiene el perfil del usuario actual autenticado.
# Autenticación: REQUERIDA - Bearer token.
# Headers:
#   Authorization: Bearer <token>
# Respuesta exitosa (200):
#   {
#     "user": {
#       "id": "uuid-del-usuario",
#       "email": "juan@example.com",
#       "name": "Juan Perez",
#       "role": "CLIENT"
#     }
#   }

###
# Obtener perfil del usuario actual
GET {{baseURL}}/auth/me
Authorization: Bearer {{token}}